# Google AI Studio (Gemini) API key for the chat LLM and embeddings — https://aistudio.google.com/
GOOGLE_API_KEY=

# Tavily Search API key (web-search fallback) — https://tavily.com
TAVILY_API_KEY=

# Pinecone vector db creds
PINECONE_API_KEY=
PINECONE_INDEX_NAME=youtube-transcripts

# Optional overrides (defaults shown)
# GEMINI_MODEL=gemini-3.5-flash-lite
# EMBEDDING_MODEL=gemini-embedding-001
# SIMILARITY_THRESHOLD=0.75
# CHECKPOINT_DB=./data/checkpoints.sqlite
